{
  "name": "dd-quarry-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "astro check",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts package.json README.md CREDITS.md",
    "format:check": "prettier --check src scripts tests astro.config.mjs playwright.config.ts package.json README.md CREDITS.md"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@lucide/astro": "^1.52.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  }
}
