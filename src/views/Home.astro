---
import {
  ArrowUpRight,
  Mountain,
  FlaskConical,
  Truck,
  ShieldCheck,
  MapPin,
  ArrowRight,
} from '@lucide/astro';
import Photo from '../components/Photo.astro';
import Stats from '../components/Stats.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';
import { translations, href, type Locale } from '../i18n';
import { demoCompany } from '../data/company';
import { demoProducts } from '../data/products';
import { demoProjects } from '../data/projects';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = translations[locale];
const whyIcons = [Mountain, FlaskConical, Truck, ShieldCheck];
---

<section class="hero">
  <Photo image="quarry" locale={locale} eager sizes="100vw" />
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <p class="eyebrow">{text.home.eyebrow}</p>
    <h1>{text.home.title}</h1>
    <p class="hero-tagline">{text.home.headline}</p>
    <p class="hero-body">{text.home.body}</p>
    <div class="actions">
      <a class="button" href={href(locale, 'quote')}>
        {text.common.quote}
        <ArrowUpRight size={20} />
      </a>
      <a class="button light" href={href(locale, 'products')}>
        {text.common.viewProducts}
        <ArrowRight size={19} />
      </a>
    </div>
    <div class="hero-bottom">
      <span>
        <MapPin size={13} />
        {text.home.location}
      </span>
      <span>{text.home.since}</span>
    </div>
  </div>
</section>
<Stats
  locale={locale}
  values={[
    new Date().getFullYear() - demoCompany.founded,
    demoCompany.annualTonnes,
    demoCompany.fleet,
    demoCompany.regions,
  ]}
  labels={text.home.stats}
/>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{text.home.productsLabel}</p>
        <h2 class="preline">{text.home.productsTitle}</h2>
      </div>
      <div>
        <p class="muted">{text.home.productsBody}</p>
        <a class="text-link" href={href(locale, 'products')}>
          {text.common.allProducts}
          <ArrowUpRight size={18} />
        </a>
      </div>
    </div>
    <div class="grid four" data-reveal>
      {[demoProducts[0], demoProducts[3], demoProducts[5], demoProducts[8]].map((product) => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </div>
</section>
<section class="section tint contours">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{text.home.whyLabel}</p>
        <h2 class="preline">{text.home.whyTitle}</h2>
      </div>
      <a class="text-link" href={href(locale, 'about')}>
        {text.nav.about}
        <ArrowUpRight size={18} />
      </a>
    </div>
    <div class="grid four why-grid">
      {text.home.why.map(([title, body], index) => {
        const Icon = whyIcons[index];
        return (
          <div class="why-item" data-reveal>
            <Icon size={35} stroke-width={1.3} class="icon-box" />
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
<section class="plant-band dark">
  <div class="plant-photo">
    <Photo image="plant" locale={locale} sizes="100vw" />
    <div></div>
  </div>
  <div class="container plant-content">
    <p class="eyebrow">{text.home.plantLabel}</p>
    <h2>{text.home.plantTitle}</h2>
    <p>{text.home.plantBody}</p>
    <a class="button light" href={href(locale, 'operations')}>
      {text.common.discover}
      <ArrowUpRight size={18} />
    </a>
    <ol class="process-strip">
      {text.home.process.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {step}
        </li>
      ))}
    </ol>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{text.home.projectsLabel}</p>
        <h2 class="preline">{text.home.projectsTitle}</h2>
      </div>
      <a class="text-link" href={href(locale, 'projects')}>
        {text.common.allProjects}
        <ArrowUpRight size={18} />
      </a>
    </div>
    <div class="grid three" data-reveal>
      {demoProjects.slice(0, 3).map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
    <p class="fine photo-note">{text.common.photoNote}</p>
  </div>
</section>
<section class="section tint contours">
  <div class="container split">
    <div>
      <p class="eyebrow">{text.home.areaLabel}</p>
      <h2 class="preline">{text.home.areaTitle}</h2>
      <p class="lead">{text.home.areaBody}</p>
    </div>
    <div class="service-area" data-reveal>
      <MapPin size={34} stroke-width={1.3} />
      <p>{text.home.areaNote}</p>
      <div class="chips">
        {demoCompany.cities.map((city) => (
          <span class="chip">{city}</span>
        ))}
      </div>
    </div>
  </div>
</section>
<CTA locale={locale} />
<style>
  .hero {
    position: relative;
    background: var(--ink);
    color: white;
    min-height: 490px;
    display: flex;
    align-items: end;
    isolation: isolate;
  }
  .hero > :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, #14181f08 0%, #14181f30 20%, #14181fb3 53%, #14181ff2 100%);
  }
  .hero-content {
    padding-top: 150px;
    padding-bottom: 22px;
  }
  .hero .eyebrow {
    color: #fff;
    font-size: 11px;
    margin-bottom: 12px;
  }
  .hero h1 {
    font-size: 46px;
    max-width: 700px;
  }
  .hero-tagline {
    font-family: var(--font-heading);
    font-size: 29px;
    margin-top: 16px;
    color: var(--yellow);
    font-weight: 500;
    line-height: 1.15;
  }
  .hero-body {
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.6;
    max-width: 535px;
    color: #f0f0ee;
  }
  .hero .actions {
    gap: 10px;
    margin-top: 24px;
  }
  .hero .button {
    font-size: 14px;
    padding: 12px 15px;
    gap: 12px;
    flex: 1;
  }
  .hero-bottom {
    margin-top: 28px;
    padding-top: 15px;
    border-top: 1px solid #ffffff35;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    line-height: 1.5;
    color: #d5d9dd;
  }
  .hero-bottom > span {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .hero-bottom > span:last-child {
    text-align: right;
    max-width: 160px;
  }
  .why-item {
    padding: 24px 0;
    border-top: 1px solid #c9c5bc;
  }
  .why-item h3 {
    font-size: 29px;
    max-width: 230px;
    line-height: 1.15;
  }
  .why-item p {
    font-size: 16px;
    color: var(--muted);
    margin-top: 18px;
  }
  .plant-band {
    position: relative;
    isolation: isolate;
    padding-top: 210px;
  }
  .plant-photo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .plant-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 47% center;
  }
  .plant-photo > div {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #14181f20 0%, #14181fbd 38%, #14181f 80%);
  }
  .plant-content > p:not(.eyebrow) {
    max-width: 530px;
    margin: 22px 0 26px;
  }
  .plant-content h2 {
    max-width: 600px;
  }
  .process-strip {
    list-style: none;
    padding: 26px 0;
    margin: 36px 0 0;
    border-top: 1px solid #ffffff35;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 24px;
  }
  .process-strip li {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 18px var(--font-heading);
  }
  .process-strip span {
    font: 400 11px var(--font-body);
    color: var(--yellow);
  }
  .photo-note {
    margin-top: 28px;
  }
  .service-area > svg {
    color: var(--blue);
    margin-bottom: 18px;
  }
  .service-area > p {
    font-weight: 500;
    margin-bottom: 26px;
  }
  .service-area .chip {
    background: #ffffff70;
  }
  @media (min-width: 600px) {
    .hero {
      min-height: 550px;
      height: calc(84svh - 64px);
      max-height: 720px;
    }
    .hero-content {
      padding-top: 180px;
      padding-bottom: 24px;
    }
    .hero h1 {
      font-size: 66px;
    }
    .hero .button {
      flex: initial;
      font-size: 16px;
      padding: 14px 22px;
    }
    .hero-bottom {
      font-size: 12px;
    }
    .hero-bottom > span:last-child {
      max-width: none;
    }
    .plant-band {
      padding-top: 200px;
    }
    .process-strip {
      justify-content: space-between;
    }
    .process-strip li {
      font-size: 23px;
    }
  }
  @media (min-width: 1000px) {
    .hero {
      height: calc(100svh - 245px);
      min-height: 540px;
      max-height: 720px;
    }
    .hero :global(img) {
      object-position: center 48%;
    }
    .hero-content {
      padding-top: 170px;
      padding-bottom: 24px;
    }
    .hero h1 {
      font-size: 78px;
      max-width: 770px;
    }
    .hero-tagline {
      font-size: 36px;
    }
    .hero .eyebrow {
      font-size: 12px;
    }
    .hero-body {
      font-size: 18px;
      max-width: 540px;
    }
    .hero-bottom {
      margin-top: 35px;
    }
    .why-grid {
      gap: 35px;
    }
    .plant-band {
      padding-top: 170px;
    }
    .plant-photo > div {
      background:
        linear-gradient(90deg, #14181fdf, #14181f50),
        linear-gradient(0deg, #14181f 0%, transparent 75%);
    }
    .plant-content h2 {
      font-size: 58px;
    }
    .plant-content > p {
      font-size: 18px;
    }
    .process-strip {
      margin-top: 50px;
      padding: 30px 0;
    }
    .process-strip li {
      font-size: 26px;
    }
  }
</style>
