---
import { ArrowUpRight } from '@lucide/astro';
import Intro from '../components/Intro.astro';
import ProductCard from '../components/ProductCard.astro';
import Filter from '../components/Filter.astro';
import CTA from '../components/CTA.astro';
import { demoProducts } from '../data/products';
import { translations, href, number, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = translations[locale];
---

<Intro label={text.products.label} title={text.products.title} body={text.products.intro} />
<section class="section">
  <div class="container" data-filter-scope>
    <h2 class="sr-only">{text.nav.products}</h2>
    <Filter locale={locale} categories={text.products.categories} label={text.nav.products} />
    <div class="grid three">
      {demoProducts.map((product) => (
        <ProductCard product={product} locale={locale} />
      ))}
    </div>
  </div>
</section>
<section class="section tint">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{text.products.specIntro}</p>
        <h2>{text.products.specTitle}</h2>
      </div>
    </div>
    <table>
      <caption class="sr-only">{text.products.specIntro}</caption>
      <thead>
        <tr>
          {text.products.headings.map((heading) => (
            <th scope="col">{heading}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {demoProducts.map((product) => (
          <tr>
            <th scope="row">{product.name[locale]}</th>
            <td data-label={text.products.headings[1]}>
              {product.fraction
                ? product.fraction.map((value) => number(value, locale)).join('–') +
                  ' ' +
                  text.common.mm
                : text.products.customFraction}
            </td>
            <td data-label={text.products.headings[2]}>{product.use[locale]}</td>
            <td data-label={text.products.headings[3]}>
              {product.density.map((value) => number(value, locale)).join('–')}{' '}
              {text.common.densityUnit}
            </td>
            <td data-label={text.products.headings[4]}>
              {product.standard || text.products.noStandard}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="fine spec-note">{text.products.disclaimer}</p>
  </div>
</section>
<section class="section">
  <div class="container split">
    <h2>{text.products.customTitle}</h2>
    <div>
      <p class="lead">{text.products.customBody}</p>
      <a class="text-link" href={href(locale, 'quote')}>
        {text.common.quote}
        <ArrowUpRight size={18} />
      </a>
    </div>
  </div>
</section>
<CTA locale={locale} />
<style>
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  tbody {
    display: grid;
    gap: 20px;
  }
  tr {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    padding: 18px;
  }
  th[scope='row'] {
    display: block;
    font-size: 22px;
    font-family: var(--font-heading);
    text-align: left;
    padding-bottom: 12px;
  }
  td {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 9px 0;
    border-top: 1px solid #e8e5df;
    text-align: right;
    line-height: 1.45;
  }
  td:before {
    content: attr(data-label);
    text-align: left;
    flex: 0 0 36%;
    color: var(--muted);
    font-size: 14px;
  }
  .spec-note {
    margin-top: 28px;
    max-width: 950px;
  }
  @media (min-width: 1000px) {
    thead {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
    }
    thead th {
      background: var(--ink);
      color: white;
      font-weight: 500;
      text-align: left;
      padding: 15px 18px;
    }
    tbody {
      display: table-row-group;
    }
    tr {
      display: table-row;
      padding: 0;
      border: 0;
      background: transparent;
    }
    tbody tr:nth-child(odd) {
      background: #fff;
    }
    th[scope='row'] {
      display: table-cell;
      font-size: 18px;
      font-family: var(--font-body);
      padding: 18px;
      font-weight: 500;
      border-bottom: 1px solid var(--line);
    }
    td {
      display: table-cell;
      text-align: left;
      padding: 18px;
      font-size: 15px;
      border: 0;
      border-bottom: 1px solid var(--line);
    }
    td:before {
      display: none;
    }
    td:nth-child(2),
    td:nth-child(4) {
      white-space: nowrap;
    }
  }
</style>
