---
import { Check, ShieldCheck, FlaskConical } from '@lucide/astro';
import Photo from '../components/Photo.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';
import { translations, type Locale } from '../i18n';
import { demoCompany } from '../data/company';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = translations[locale];
---

<section class="operations-hero dark">
  <div class="banner">
    <Photo image="plant" locale={locale} eager sizes="100vw" />
  </div>
  <div class="container operations-heading">
    <p class="eyebrow">{text.operations.label}</p>
    <h1 class="preline">{text.operations.title}</h1>
    <p class="lead">{text.operations.intro}</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <p class="eyebrow">{text.operations.processLabel}</p>
    <h2>{text.operations.processTitle}</h2>
    <ol class="steps">
      {text.operations.steps.map(([title, body], index) => (
        <li data-reveal>
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<Stats
  locale={locale}
  values={[
    demoCompany.plantCapacity,
    demoCompany.annualTonnes,
    demoCompany.trucks,
    demoCompany.machines,
  ]}
  labels={text.operations.capacity}
/>
<section class="section contours">
  <div class="container split">
    <div>
      <p class="eyebrow">{text.operations.engineeringLabel}</p>
      <h2>{text.operations.engineeringTitle}</h2>
      <p class="lead">{text.operations.engineeringBody}</p>
      <ul class="check-list">
        {text.operations.engineeringPoints.map((item) => (
          <li>
            <Check size={20} />
            {item}
          </li>
        ))}
      </ul>
    </div>
    <figure class="engineering" data-reveal>
      <Photo image="engineering" locale={locale} />
      <figcaption>{text.images.engineering}</figcaption>
    </figure>
  </div>
</section>
<section class="section tint">
  <div class="container">
    <div class="section-head">
      <div>
        <FlaskConical class="icon-box" size={36} stroke-width={1.3} />
        <h2>{text.operations.qualityTitle}</h2>
      </div>
      <p class="muted">{text.operations.qualityBody}</p>
    </div>
    <div class="grid four">
      {text.operations.tests.map(([title, body]) => (
        <div class="test" data-reveal>
          <h3>{title}</h3>
          <p>{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="section dark">
  <div class="container split">
    <div>
      <ShieldCheck class="icon-box" size={38} stroke-width={1.3} />
      <h2 class="preline">{text.operations.safetyTitle}</h2>
    </div>
    <ul class="safety-list">
      {text.operations.safety.map((item) => (
        <li>
          <Check size={20} />
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
<CTA locale={locale} />
<style>
  .operations-hero {
    position: relative;
  }
  .banner {
    height: 210px;
    position: relative;
  }
  .banner :global(img) {
    width: 100%;
    height: 210px;
    object-fit: cover;
    object-position: 40% center;
  }
  .banner:after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #14181f 0%, #14181f10 70%);
  }
  .operations-heading {
    padding: 12px 0 42px;
  }
  .operations-heading h1 {
    font-size: 48px;
  }
  .operations-heading .lead {
    color: #cbd0d7;
    max-width: 550px;
  }
  .steps {
    display: grid;
    list-style: none;
    gap: 0;
    padding: 0;
    margin: 40px 0 0;
  }
  .steps li {
    display: flex;
    gap: 22px;
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }
  .step-number {
    font: 600 38px var(--font-heading);
    color: var(--blue);
    min-width: 42px;
  }
  .steps h3 {
    font-size: 29px;
    line-height: 1.12;
  }
  .steps p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
  }
  .engineering {
    border: 1px solid var(--line);
    padding: 10px;
    background: #fff;
  }
  .engineering :global(img) {
    width: 100%;
    height: auto;
  }
  .engineering figcaption {
    padding: 16px 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  .test {
    border-top: 2px solid var(--blue);
    padding-top: 24px;
  }
  .test p {
    margin-top: 16px;
    font-size: 16px;
    color: var(--muted);
  }
  .safety-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .safety-list li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #ffffff25;
  }
  .safety-list svg,
  .dark .icon-box {
    color: var(--yellow);
  }
  @media (min-width: 700px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 42px;
    }
    .banner {
      height: 320px;
    }
    .banner :global(img) {
      height: 320px;
    }
  }
  @media (min-width: 1000px) {
    .operations-hero {
      min-height: 580px;
      display: flex;
      align-items: end;
      isolation: isolate;
    }
    .banner {
      position: absolute;
      inset: 0;
      height: 100%;
      z-index: -1;
    }
    .banner :global(img) {
      height: 100%;
      object-position: center;
    }
    .banner:after {
      background: linear-gradient(0deg, #14181fee 0%, #14181f75 50%, #14181f15 100%);
    }
    .operations-heading {
      padding: 190px 0 52px;
    }
    .operations-heading h1 {
      font-size: 72px;
    }
    .steps {
      column-gap: 75px;
      margin-top: 56px;
    }
    .steps li {
      padding: 34px 0;
    }
    .step-number {
      font-size: 48px;
      min-width: 56px;
    }
  }
</style>
