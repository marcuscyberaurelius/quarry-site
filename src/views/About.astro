---
import { ShieldCheck, FileCheck } from '@lucide/astro';
import Intro from '../components/Intro.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
import { translations, type Locale } from '../i18n';
import { demoCompany } from '../data/company';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const text = translations[locale];
---
<Intro label={text.about.label} title={text.about.title} body={text.about.intro}/>
<section class="section"><div class="container split"><div><h2>{text.about.storyTitle}</h2><p class="lead">{text.about.story}</p></div><figure class="story-image" data-reveal><Photo image="quarry" locale={locale}/><figcaption>{text.home.location} / {text.home.since}</figcaption></figure></div></section>
<section class="section dark"><div class="container"><p class="eyebrow">{text.about.missionTitle}</p><h2 class="mission">{text.about.mission}</h2><div class="grid three values">{text.about.values.map(([title,body])=><div><h3>{title}</h3><p>{body}</p></div>)}</div></div></section>
<section class="section tint contours"><div class="container"><h2>{text.about.timelineTitle}</h2><ol class="timeline">{text.about.milestones.map(([year,body])=><li data-reveal><span>{year}</span><p>{body}</p></li>)}</ol></div></section>
<section class="section"><div class="container"><h2>{text.about.teamTitle}</h2><div class="grid four team">{demoCompany.team.map((name,index)=><article><div class="avatar" aria-hidden="true">{name.split(' ').map(part=>part[0]).join('')}</div><h3>{name}</h3><p>{text.about.teamRoles[index]}</p></article>)}</div></div></section>
<section class="section tint"><div class="container"><div class="section-head"><h2>{text.about.certificatesTitle}</h2><p class="fine">{text.about.certificateNote}</p></div><div class="grid four certificates">{text.about.certificates.map(([title,body])=><div><FileCheck size={30} stroke-width={1.3}/><h3>{title}</h3><p>{body}</p></div>)}</div></div></section>
<section class="section"><div class="container split"><div><ShieldCheck size={38} stroke-width={1.3} class="icon-box"/><h2>{text.about.commitmentTitle}</h2></div><p class="lead">{text.about.commitment}</p></div></section><CTA locale={locale}/>
<style>.story-image :global(img){width:100%;aspect-ratio:4/3;object-fit:cover}.story-image figcaption{font-size:11px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px;margin-top:14px}.mission{max-width:980px;font-size:38px;line-height:1.18}.values{margin-top:50px}.values>div{border-top:1px solid #ffffff40;padding-top:25px}.values p{margin-top:18px;font-size:16px}.timeline{list-style:none;padding:0;margin:42px 0 0;display:grid;gap:0}.timeline li{display:grid;grid-template-columns:70px minmax(0,1fr);gap:25px;border-top:1px solid var(--line);padding:26px 0}.timeline span{font:600 32px var(--font-heading);color:var(--blue)}.timeline p{font-size:17px}.team{margin-top:40px;row-gap:35px}.avatar{width:86px;height:86px;background:var(--stone);border-bottom:3px solid var(--yellow);color:var(--blue);display:grid;place-items:center;font:600 36px var(--font-heading);margin-bottom:24px}.team h3{font-size:29px}.team p{font-size:16px;color:var(--muted);margin-top:12px}.certificates>div{padding-top:22px;border-top:1px solid var(--line)}.certificates svg{color:var(--blue);margin-bottom:22px}.certificates p{font-size:16px;color:var(--muted);margin-top:16px}@media(min-width:1000px){.mission{font-size:54px}.timeline{grid-template-columns:repeat(5,minmax(0,1fr));gap:24px}.timeline li{display:flex;flex-direction:column;gap:25px;border-top:2px solid var(--blue)}.timeline span{font-size:40px}}</style>