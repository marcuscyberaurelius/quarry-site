---
import { href, translations, type Locale, type Page } from '../i18n';
interface Props { locale: Locale; page: Page; }
const { locale, page } = Astro.props;
---
<nav class="languages" aria-label={translations[locale].language}>
  {(['en', 'sq'] as const).map(language => <a data-language href={href(language, page)} hreflang={language} lang={language} aria-current={locale === language ? 'true' : undefined}>{translations[locale].languages[language]}</a>)}
</nav>
<style>.languages{display:flex;align-items:center;flex-shrink:0}.languages a{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:13px;font-weight:600;position:relative;opacity:.65}.languages a+a:before{content:'';position:absolute;left:0;height:12px;border-left:1px solid currentColor;opacity:.35}.languages a[aria-current]{opacity:1;text-decoration:underline;text-underline-offset:5px}.languages a:hover{opacity:1}</style>