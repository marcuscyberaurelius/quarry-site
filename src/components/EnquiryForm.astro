---
import { ArrowUpRight, CircleCheck, RotateCcw } from '@lucide/astro';
import Field from './FormField.astro';
import { translations, type Locale } from '../i18n';
import { demoProducts } from '../data/products';
import { demoCompany } from '../data/company';
interface Props {
  locale: Locale;
  quote?: boolean;
}
const { locale, quote = false } = Astro.props;
const text = translations[locale];
---

<div class="enquiry" data-enquiry data-errors={JSON.stringify(text.form.errors)}>
  <form novalidate data-demo-form>
    <p class="required-note">{text.form.requiredNote}</p>
    <Field name="name" label={text.form.name}>
      <input
        id="name"
        name="name"
        autocomplete="name"
        required
        maxlength="120"
        aria-describedby="name-error"
      />
    </Field>
    {quote && (
      <Field name="company" label={text.form.company} optional={text.form.optional}>
        <input
          id="company"
          name="company"
          autocomplete="organization"
          maxlength="150"
          aria-describedby="company-error"
        />
      </Field>
    )}
    <Field name="phone" label={text.form.phone}>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        required
        maxlength="30"
        aria-describedby="phone-error"
      />
    </Field>
    <Field name="email" label={text.form.email}>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
        aria-describedby="email-error"
      />
    </Field>
    {quote && (
      <>
        <Field name="product" label={text.form.product}>
          <select id="product" name="product" required aria-describedby="product-error">
            <option value="">{text.form.choose}</option>
            {demoProducts.map((product) => (
              <option value={product.id}>{product.name[locale]}</option>
            ))}
          </select>
        </Field>
        <Field name="quantity" label={text.form.quantity}>
          <input
            id="quantity"
            name="quantity"
            type="text"
            inputmode="decimal"
            required
            maxlength="12"
            aria-describedby="quantity-error"
          />
        </Field>
        <Field name="unit" label={text.form.unit}>
          <select id="unit" name="unit" required aria-describedby="unit-error">
            <option value="tonnes">{text.form.tonnes}</option>
            <option value="m3">{text.form.cubic}</option>
          </select>
        </Field>
        <Field name="location" label={text.form.location}>
          <input
            id="location"
            name="location"
            list="regions"
            autocomplete="address-level2"
            required
            maxlength="150"
            aria-describedby="location-error"
          />
          <datalist id="regions">
            {demoCompany.cities.map((city) => (
              <option value={city} />
            ))}
          </datalist>
        </Field>
        <Field name="date" label={text.form.date}>
          <input id="date" name="date" type="date" required aria-describedby="date-error" />
        </Field>
        <fieldset>
          <legend>{text.form.fulfilment}</legend>
          <label class="choice">
            <input type="radio" name="fulfilment" value="delivery" checked />
            {text.form.delivery}
          </label>
          <label class="choice">
            <input type="radio" name="fulfilment" value="collection" />
            {text.form.collection}
          </label>
        </fieldset>
      </>
    )}
    <Field
      name="message"
      label={text.form.message}
      optional={quote ? text.form.optional : undefined}
    >
      <textarea
        id="message"
        name="message"
        rows="5"
        maxlength="4000"
        required={!quote}
        aria-describedby="message-error"
      ></textarea>
    </Field>
    <div>
      <label class="consent">
        <input
          id="consent"
          name="consent"
          type="checkbox"
          required
          aria-describedby="consent-error"
        />
        <span>{text.form.consent}</span>
      </label>
      <p class="field-error" id="consent-error" aria-live="polite"></p>
    </div>
    <p class="demo-note">{text.form.demoNote}</p>
    <button class="button submit" type="submit" disabled>
      {quote ? text.form.submit : text.form.send}
      <ArrowUpRight size={20} />
    </button>
    <noscript>
      <p>{text.form.noJs}</p>
    </noscript>
  </form>
  <section class="success" hidden tabindex="-1" aria-live="polite">
    <CircleCheck size={44} stroke-width={1.3} />
    <h2>{text.form.successTitle}</h2>
    <p>{text.form.success}</p>
    <button type="button" class="button outline" data-reset>
      <RotateCcw size={18} />
      {text.form.again}
    </button>
  </section>
</div>
<script>
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  document.querySelectorAll<HTMLElement>('[data-enquiry]').forEach((container) => {
    const form = container.querySelector<HTMLFormElement>('form')!;
    const messages: Record<string, string> = JSON.parse(container.dataset.errors || '{}');
    const controls = [...form.querySelectorAll<Control>('input:not([type=radio]),select,textarea')];
    const success = container.querySelector<HTMLElement>('.success')!;
    const submit = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    submit.disabled = false;
    const product = form.querySelector<HTMLSelectElement>('#product');
    const selected = new URLSearchParams(window.location.search).get('product');
    if (product && selected && [...product.options].some((option) => option.value === selected))
      product.value = selected;
    const date = form.querySelector<HTMLInputElement>('#date');
    const today = () => {
      const now = new Date();
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    };
    if (date) date.min = today();
    const validate = (control: Control) => {
      let message = '';
      const value = control.value.trim();
      if (control instanceof HTMLInputElement && control.type === 'checkbox') {
        if (control.required && !control.checked) message = messages.consent;
      } else if (control.required && !value) message = messages.required;
      else if (value) {
        if (control.name === 'email' && control.validity.typeMismatch) message = messages.email;
        if (
          control.name === 'phone' &&
          (!/^[+\d\s().-]+$/.test(value) ||
            value.replace(/\D/g, '').length < 7 ||
            value.replace(/\D/g, '').length > 15)
        )
          message = messages.phone;
        if (
          control.name === 'quantity' &&
          (!/^\d+(?:[.,]\d+)?$/.test(value) || Number(value.replace(',', '.')) <= 0)
        )
          message = messages.quantity;
        if (control.name === 'date' && (value < today() || !/^\d{4}-\d{2}-\d{2}$/.test(value)))
          message = messages.date;
      }
      control.setAttribute('aria-invalid', String(Boolean(message)));
      const output = document.getElementById(`${control.id}-error`);
      if (output) output.textContent = message;
      return !message;
    };
    controls.forEach((control) => {
      control.addEventListener('blur', () => validate(control));
      control.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true') validate(control);
      });
      control.addEventListener('change', () => validate(control));
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const results = controls.map((control) => validate(control));
      if (results.includes(false)) {
        controls[results.indexOf(false)].focus();
        return;
      }
      // TODO: Connect a form service here, await its response, and handle network errors before showing a live success state.
      form.hidden = true;
      success.hidden = false;
      success.focus();
    });
    container.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      controls.forEach((control) => {
        control.removeAttribute('aria-invalid');
        const output = document.getElementById(`${control.id}-error`);
        if (output) output.textContent = '';
      });
      success.hidden = true;
      form.hidden = false;
      controls[0].focus();
    });
  });
</script>
<style>
  form {
    display: grid;
    gap: 24px;
    max-width: 720px;
  }
  .required-note {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  form :global(input:not([type='checkbox']):not([type='radio'])),
  form :global(select),
  form :global(textarea) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 52px;
    border: 1px solid #999fa5;
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    padding: 12px 14px;
    font-size: 16px;
    line-height: 1.5;
    appearance: auto;
  }
  form :global(textarea) {
    resize: vertical;
  }
  form :global([aria-invalid='true']) {
    border-color: #b3232e !important;
    background: #fff8f7 !important;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  legend {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .choice {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    font-size: 16px;
  }
  .choice input,
  .consent input {
    width: 22px;
    height: 22px;
    accent-color: var(--blue);
    flex-shrink: 0;
    margin: 0;
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-height: 44px;
    font-size: 16px;
    line-height: 1.5;
  }
  .consent input {
    margin-top: 3px;
  }
  .field-error {
    color: #a51c25;
    font-size: 14px;
    margin-top: 8px;
  }
  .field-error:empty {
    display: none;
  }
  .demo-note {
    font-size: 14px;
    background: var(--stone);
    padding: 16px;
    border-left: 3px solid var(--blue);
  }
  .submit {
    justify-self: start;
    max-width: 100%;
  }
  .submit:disabled {
    opacity: 0.55;
  }
  .success {
    border-top: 3px solid var(--blue);
    padding: 30px 0;
  }
  .success > svg {
    color: var(--blue);
    margin-bottom: 24px;
  }
  .success p {
    margin-top: 22px;
  }
  .success .button {
    margin-top: 28px;
  }
</style>
