---
import { MapPin } from '@lucide/astro';
import Photo from './Photo.astro';
import { translations, number, type Locale } from '../i18n';
import type { Project } from '../data/projects';
interface Props { project: Project; locale: Locale; }
const { project, locale } = Astro.props;
const text = translations[locale];
---
<article class="project-card" data-category={project.category}>
  <div class="project-image"><Photo image={project.image} locale={locale} sizes="(min-width: 1000px) 390px, (min-width: 600px) 45vw, 90vw" maxWidth={800}/><span>{text.projects.categories[project.category]}</span></div>
  <div class="project-details"><p class="location"><MapPin size={14}/>{project.location}<span>{project.year}</span></p><h3>{project.title[locale]}</h3><p class="material">{project.material[locale]}</p><p class="tonnage"><strong>{number(project.tonnes,locale)} <small>{text.common.tonnes}</small></strong><span>{text.projects.supplied}</span></p></div>
</article>
<style>.project-card{display:flex;flex-direction:column;min-width:0}.project-image{position:relative;height:230px;overflow:hidden}.project-image :global(img){width:100%;height:230px;object-fit:cover}.project-image>span{position:absolute;bottom:14px;left:14px;background:white;padding:6px 11px;font-size:12px;line-height:1.4;color:var(--blue);font-weight:600}.project-details{padding-top:19px;display:flex;flex-direction:column;flex:1}.location{display:flex;gap:7px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:14px}.location>span{margin-left:auto}.project-card h3{font-size:30px;line-height:1.13}.material{font-size:16px;color:var(--muted);margin-top:15px;margin-bottom:20px}.tonnage{border-top:1px solid var(--line);padding-top:16px;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:auto}.tonnage strong{font:600 28px var(--font-heading);color:var(--blue)}.tonnage small{font:400 14px var(--font-body)}.tonnage>span{font-size:12px;color:var(--muted)}</style>