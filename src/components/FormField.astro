---
interface Props { name: string; label: string; optional?: string; }
const { name, label, optional } = Astro.props;
---
<div class="field"><label for={name}>{label}{optional && <span> ({optional})</span>}</label><slot/><p class="field-error" id={`${name}-error`} aria-live="polite"></p></div>
<style>.field{display:flex;flex-direction:column;gap:8px;min-width:0}.field label{font-size:16px;font-weight:500}.field label span{font-size:14px;color:var(--muted);font-weight:400}.field-error{font-size:14px;color:#a51c25;line-height:1.4}.field-error:empty{display:none}</style>