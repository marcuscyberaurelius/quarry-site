---
import { Menu, X, ArrowUpRight, Phone, Mail } from '@lucide/astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { href, navPages, translations, type Locale, type Page } from '../i18n';
import { demoCompany } from '../data/company';
interface Props {
  locale: Locale;
  page: Page;
}
const { locale, page } = Astro.props;
const text = translations[locale];
---

<aside class="topbar" aria-label={text.common.contact}>
  <div class="container top-inner">
    <div class="top-contact">
      <a href={`tel:${demoCompany.tel}`}>
        <Phone size={13} />
        {demoCompany.phone}
      </a>
      <a href={`mailto:${demoCompany.email}`}>
        <Mail size={14} />
        {demoCompany.email}
      </a>
    </div>
    <div class="top-hours">
      {text.common.weekdays}
      <span class="top-divider"></span>
      {text.common.saturday}
    </div>
    <LanguageSwitcher locale={locale} page={page} />
  </div>
</aside>
<header class="site-header" id="site-header">
  <div class="container nav-inner">
    <a class="logo-link" href={href(locale)} aria-label={`${text.brand}${text.brandLine}`}>
      <Logo locale={locale} />
    </a>
    <nav class="desktop-nav" aria-label={text.common.links}>
      {navPages.map((item) => (
        <a href={href(locale, item)} aria-current={page === item ? 'page' : undefined}>
          {text.nav[item]}
        </a>
      ))}
    </nav>
    <a class="button desktop-quote" href={href(locale, 'quote')}>
      {text.common.quote}
      <ArrowUpRight size={18} />
    </a>
    <div class="mobile-actions">
      <LanguageSwitcher locale={locale} page={page} />
      <button
        class="menu-toggle"
        aria-label={text.common.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu size={23} />
      </button>
    </div>
  </div>
</header>
<dialog id="mobile-menu" aria-label={text.common.links}>
  <div class="menu-top">
    <Logo locale={locale} />
    <LanguageSwitcher locale={locale} page={page} />
    <button class="menu-close" aria-label={text.common.closeMenu}>
      <X size={26} />
    </button>
  </div>
  <nav class="menu-links" aria-label={text.common.links}>
    {navPages.map((item, index) => (
      <a href={href(locale, item)} aria-current={page === item ? 'page' : undefined}>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        {text.nav[item]}
        <ArrowUpRight size={22} />
      </a>
    ))}
  </nav>
  <a class="button" href={href(locale, 'quote')}>
    {text.common.quote}
    <ArrowUpRight size={20} />
  </a>
  <div class="menu-contact">
    <a href={`tel:${demoCompany.tel}`}>{demoCompany.phone}</a>
    <a href={`mailto:${demoCompany.email}`}>{demoCompany.email}</a>
    <p>
      {text.common.weekdays}
      <br />
      {text.common.saturday}
    </p>
  </div>
</dialog>
<script>
  const header = document.querySelector<HTMLElement>('#site-header');
  const updateHeader = () => header?.classList.toggle('scrolled', window.scrollY > 20);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const closeMenu = () => menu?.close();
  toggle?.addEventListener('click', () => {
    menu?.showModal();
    document.body.classList.add('modal-open');
    toggle.setAttribute('aria-expanded', 'true');
  });
  menu?.querySelector('.menu-close')?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  menu?.addEventListener('close', () => {
    document.body.classList.remove('modal-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.focus();
  });
  window.matchMedia('(min-width: 1000px)').addEventListener('change', (event) => {
    if (event.matches) closeMenu();
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
    link.search = window.location.search;
    link.hash = window.location.hash;
  });
</script>
<style>
  .topbar {
    display: none;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffffed;
    transition:
      box-shadow 0.2s,
      background 0.2s;
    border-bottom: 1px solid #14181f12;
  }
  .site-header.scrolled {
    background: #fff;
    box-shadow: 0 3px 18px #14181f12;
  }
  .nav-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .logo-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }
  .logo-link :global(.logo) {
    width: 125px;
  }
  .desktop-nav,
  .desktop-quote {
    display: none;
  }
  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .menu-toggle,
  .menu-close {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
  }
  .menu-toggle {
    border-left: 1px solid var(--line);
  }
  #mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0 20px 32px;
    background: var(--stone);
    color: var(--ink);
    overflow-y: auto;
  }
  #mobile-menu::backdrop {
    background: #14181f90;
  }
  .menu-top {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
  }
  .menu-top :global(.logo) {
    width: 125px;
  }
  .menu-links {
    margin: 20px 0 24px;
  }
  .menu-links a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font: 600 31px/1.15 var(--font-heading);
    min-height: 52px;
  }
  .menu-links a[aria-current] {
    color: var(--blue);
  }
  .menu-links span {
    font: 400 13px var(--font-body);
    color: var(--muted);
  }
  .menu-links svg {
    margin-left: auto;
  }
  .menu-contact {
    margin-top: 24px;
    display: grid;
    gap: 3px;
  }
  .menu-contact a {
    display: flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
  .menu-contact p {
    font-size: 16px;
    color: var(--muted);
  }
  @media (min-width: 1000px) {
    .topbar {
      display: block;
      background: var(--ink);
      color: #e1e5eb;
      font-size: 13px;
    }
    .top-inner,
    .top-contact {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .top-inner {
      justify-content: space-between;
      min-height: 40px;
    }
    .top-contact a {
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
    }
    .top-hours {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .top-divider {
      height: 12px;
      width: 1px;
      background: #ffffff40;
    }
    .nav-inner {
      height: 88px;
      gap: 20px;
    }
    .logo-link :global(.logo) {
      width: 168px;
    }
    .desktop-nav {
      display: flex;
      gap: 20px;
      margin-left: auto;
      align-items: center;
    }
    .desktop-nav a {
      display: flex;
      align-items: center;
      min-height: 48px;
      font-size: 15px;
      font-weight: 500;
      position: relative;
      white-space: nowrap;
    }
    .desktop-nav a:hover,
    .desktop-nav a[aria-current] {
      color: var(--blue);
    }
    .desktop-nav a[aria-current]:after {
      position: absolute;
      content: '';
      bottom: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--blue);
    }
    .desktop-quote {
      display: flex;
      font-size: 15px;
      padding: 12px 16px;
      gap: 14px;
    }
    .mobile-actions {
      display: none;
    }
  }
</style>
