---
import PageView from '../views/Page.astro';
import { pages, type Page } from '../i18n';
export function getStaticPaths() {
  return pages
    .filter((page) => page !== 'home')
    .map((page) => ({ params: { page }, props: { page } }));
}
interface Props {
  page: Page;
}
const { page } = Astro.props;
---

<PageView locale="en" page={page} />
